<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
    Checkstyle configuration for oie-git-sync.

    Based loosely on Google Java Style, relaxed where the Swing settings panel
    and the JGit wrapper would otherwise produce noise without adding value.

    Philosophy: catch things that are genuinely wrong (unused imports, missing
    overrides, star imports, tab characters, empty catches), not things that
    are merely stylistic preferences.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Catch tabs before they're committed. -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- Enforce newline at EOF. -->
    <module name="NewlineAtEndOfFile">
        <property name="lineSeparator" value="lf"/>
    </module>

    <!-- Max file length — tightened after the promote() extraction in
         Phase 4 brought GitSyncPlugin back under 1300. -->
    <module name="FileLength">
        <property name="max" value="1500"/>
    </module>

    <!-- Line length — 120 is the sweet spot for Java on wide monitors.
         (LineLength is a file-level check in modern Checkstyle, not TreeWalker.) -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^\s*(//|\*)\s*https?://"/>
    </module>

    <module name="TreeWalker">

        <!-- Imports -->
        <module name="AvoidStarImport"/>
        <module name="UnusedImports">
            <property name="processJavadoc" value="true"/>
        </module>
        <module name="RedundantImport"/>

        <!-- Annotations -->
        <module name="MissingOverride"/>
        <module name="AnnotationLocation">
            <property name="allowSamelineSingleParameterlessAnnotation" value="false"/>
        </module>

        <!-- Whitespace -->
        <module name="WhitespaceAfter"/>
        <module name="GenericWhitespace"/>
        <module name="NoWhitespaceBefore"/>
        <module name="MethodParamPad"/>
        <module name="ParenPad"/>

        <!-- Blocks -->
        <module name="NeedBraces">
            <property name="tokens" value="LITERAL_IF, LITERAL_ELSE, LITERAL_FOR, LITERAL_WHILE, LITERAL_DO"/>
            <property name="allowSingleLineStatement" value="true"/>
        </module>
        <module name="EmptyBlock">
            <property name="option" value="text"/>
            <!-- Allow empty blocks in catches that have a comment explaining why. -->
            <property name="tokens" value="LITERAL_WHILE, LITERAL_TRY, LITERAL_FINALLY, LITERAL_DO, LITERAL_IF, LITERAL_ELSE, LITERAL_FOR, INSTANCE_INIT, STATIC_INIT, LITERAL_SWITCH, LITERAL_SYNCHRONIZED"/>
        </module>

        <!-- Common coding problems -->
        <module name="EmptyStatement"/>
        <module name="EqualsHashCode"/>
        <module name="MissingSwitchDefault"/>
        <module name="FallThrough"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="OneStatementPerLine"/>
        <module name="StringLiteralEquality"/>
        <module name="ModifiedControlVariable"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>

        <!-- Naming conventions — fairly loose to keep noise down. -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="TypeName"/>
        <!-- Allow "logger" for the log4j logger convention as well as standard
             UPPER_SNAKE_CASE constants. -->
        <module name="ConstantName">
            <property name="format" value="^(logger|[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)$"/>
        </module>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="MethodName"/>
        <module name="ParameterName"/>

        <!-- Cyclomatic complexity — lowered from 75 to 30 after the
             promote() extraction into PromotionService (Phase 4). The
             remaining outliers are triggerFullSync (CC=27) and
             commitPending (CC=28), both inherently branchy across all
             artefact types. -->
        <module name="CyclomaticComplexity">
            <property name="max" value="30"/>
        </module>

    </module>
</module>
